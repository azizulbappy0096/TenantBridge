@{
    Layout = "_LandlordDashboardLayout";
}

<div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-gray-900">My Properties</h1>
            <p class="text-gray-500 text-sm mt-1">
                @Model.Count properties listed
            </p>
        </div>
        <button onclick="openPropertyModal()" class="flex items-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-xl text-sm hover:bg-indigo-700 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="24"
                 height="24"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 class="lucide lucide-plus w-4 h-4">
                <path d="M5 12h14"></path>
                <path d="M12 5v14"></path>
            </svg>
            Add Property
        </button>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-4">
        @foreach (var property in Model)
        {
            <partial name="~/Views/Shared/Partials/Property/_PropertyCard.cshtml" model="property" />
        }

    </div>
</div>

<!-- Modal -->
<partial name="~/Views/Shared/Partials/Property/_PropertyModal.cshtml" />

@section Scripts {
    <script>
        const modal = document.getElementById("propertyModal");
        const messageContainer = document.getElementById("messageContainer");
        const messageTemplate = (message, success) => success ? `
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">${message}</span>
            </div>
        ` : `<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">${message}</span>
            </div>`;


        function openPropertyModal() {
          modal.classList.remove("hidden");
          modal.classList.add("flex");
        }

        function closePropertyModal() {
            modal.classList.add("hidden");
            modal.classList.remove("flex");
        }

        function submitPropertyForm(event) {
            event.preventDefault();
            
            const form = event.target;
            const data = new FormData(form);

            fetch('/api/property', {
                method: 'POST',
                body: data
            }).then(async response => {
                let jsonRes = await response.json();
                if (response.ok) {
                    window.location.reload()
                } else if(response.status === 400) {
                    messageContainer.innerHTML = messageTemplate(jsonRes?.errors?.address[0], false);
                }else {
                    messageContainer.innerHTML = messageTemplate('Failed to add property. Please try again.', false);
                }
            }).catch(error => {
                messageContainer.innerHTML = messageTemplate('Failed to add property. Please try again.', false);
            });
        }

        function deleteProperty(id) {
            if (!confirm('Are you sure you want to delete this property?')) {
                return;
            }
            fetch(`/api/property/${id}`, {
                method: 'DELETE'
            }).then(response => {
                if (response.ok) {
                    document.getElementById(`property_${id}`).remove();
                } else {
                    alert('Failed to delete property. Please try again.');
                }
            }).catch(error => {
                alert('Failed to delete property. Please try again.');
            });
        }

        
    </script>
}