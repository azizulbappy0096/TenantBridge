@{
    Layout = "_LandlordDashboardLayout";
}

<main class="flex-1 p-5 lg:p-7 overflow-y-auto">
    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-gray-900">Deposit Escrow — Your Properties</h1>
                <p class="text-gray-500 text-sm mt-1">
                    Track deposit, deductions, refunds and disputes
                </p>
            </div>
            <button class="flex items-center gap-2 bg-purple-600 text-white px-4 py-2 rounded-xl text-sm hover:bg-purple-700 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-plus w-4 h-4">
                    <path d="M5 12h14"></path>
                    <path d="M12 5v14"></path>
                </svg>
                Record Deposit
            </button>
        </div>
        <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-3 flex items-start gap-2 text-sm text-indigo-700">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="24"
                 height="24"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 class="lucide lucide-info w-4 h-4 mt-0.5 shrink-0">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 16v-4"></path>
                <path d="M12 8h.01"></path>
            </svg>
            Manage deposits for your properties. Add deductions and process refunds
            when tenancy ends.
        </div>
        <div class="grid grid-cols-3 gap-4">
            <div class="bg-purple-50 border border-purple-100 rounded-2xl p-4">
                <p class="text-purple-600 text-sm">Total in Escrow</p>
                <p class="text-purple-900 mt-1"
                   style="font-size: 1.4rem; font-weight: 700">
                    ৳129,000
                </p>
            </div>
            <div class="bg-orange-50 border border-orange-100 rounded-2xl p-4">
                <p class="text-orange-600 text-sm">Deductions Claimed</p>
                <p class="text-orange-800 mt-1"
                   style="font-size: 1.4rem; font-weight: 700">
                    ৳13,000
                </p>
            </div>
            <div class="bg-red-50 border-red-100 border rounded-2xl p-4">
                <p class="text-sm text-red-600">Disputed Deposits</p>
                <p class="mt-1 text-red-800"
                   style="font-size: 1.4rem; font-weight: 700">
                    1
                </p>
            </div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-5">
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 space-y-4">
                <div class="flex items-start justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-purple-100 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="24"
                                 height="24"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="lucide lucide-shield w-5 h-5 text-purple-600">
                                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
                            </svg>
                        </div>
                        <div>
                            <p class="text-gray-900" style="font-weight: 600">Nusrat Jahan</p>
                            <p class="text-gray-400 text-xs">House 12, Banani, Dhaka</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5 text-xs px-3 py-1 rounded-full bg-blue-100 text-blue-700 border border-blue-200">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="lucide lucide-clock w-4 h-4">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        Active Tenancy
                    </div>
                </div>
                <div class="bg-gray-50 rounded-xl p-4">
                    <div class="grid grid-cols-3 gap-4 text-center">
                        <div>
                            <p class="text-gray-400 text-xs mb-1">Deposit Paid</p>
                            <p class="text-gray-900" style="font-weight: 700">৳75,000</p>
                            <p class="text-gray-400 text-xs mt-0.5">2023-09-01</p>
                        </div>
                        <div>
                            <p class="text-gray-400 text-xs mb-1">Deductions</p>
                            <p class="text-orange-600" style="font-weight: 700">৳0</p>
                            <p class="text-gray-400 text-xs mt-0.5">0% of deposit</p>
                        </div>
                        <div>
                            <p class="text-gray-400 text-xs mb-1">Net Refundable</p>
                            <p class="text-indigo-700" style="font-weight: 700">৳75,000</p>
                        </div>
                    </div>
                </div>
                <div class="text-sm text-gray-400 text-center py-2">
                    No deductions claimed yet
                </div>
                <div class="flex gap-2 pt-2 border-t border-gray-50">
                    <button class="flex-1 text-sm border border-gray-200 text-gray-600 py-2 rounded-xl hover:bg-gray-50 transition-colors">
                        Add Deduction
                    </button><button class="flex-1 text-sm bg-purple-600 text-white py-2 rounded-xl hover:bg-purple-700 transition-colors">
                    Process Refund
                </button>
            </div>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 space-y-4">
            <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-purple-100 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="lucide lucide-shield w-5 h-5 text-purple-600">
                            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-gray-900" style="font-weight: 600">
                            Farhan Hossain
                        </p>
                        <p class="text-gray-400 text-xs">Flat 4B, Mirpur-10, Dhaka</p>
                    </div>
                </div>
                <div class="flex items-center gap-1.5 text-xs px-3 py-1 rounded-full bg-red-100 text-red-700 border border-red-200">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="24"
                         height="24"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         class="lucide lucide-triangle-alert w-4 h-4">
                        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
                        <path d="M12 9v4"></path>
                        <path d="M12 17h.01"></path>
                    </svg>
                    Pending Dispute
                </div>
            </div>
            <div class="bg-gray-50 rounded-xl p-4">
                <div class="grid grid-cols-3 gap-4 text-center">
                    <div>
                        <p class="text-gray-400 text-xs mb-1">Deposit Paid</p>
                        <p class="text-gray-900" style="font-weight: 700">৳54,000</p>
                        <p class="text-gray-400 text-xs mt-0.5">2024-06-01</p>
                    </div>
                    <div>
                        <p class="text-gray-400 text-xs mb-1">Deductions</p>
                        <p class="text-orange-600" style="font-weight: 700">- ৳13,000</p>
                        <p class="text-gray-400 text-xs mt-0.5">24% of deposit</p>
                    </div>
                    <div>
                        <p class="text-gray-400 text-xs mb-1">Net Refundable</p>
                        <p class="text-indigo-700" style="font-weight: 700">৳41,000</p>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
                        <div class="h-2 rounded-full bg-orange-400"
                             style="width: 24%"></div>
                    </div>
                    <div class="flex justify-between text-xs text-gray-400 mt-1">
                        <span>Deducted 24%</span><span>Refundable 76%</span>
                    </div>
                </div>
            </div>
            <div>
                <p class="text-sm text-gray-600 mb-2" style="font-weight: 500">
                    Claimed Deductions
                </p>
                <div class="space-y-2">
                    <div class="flex items-center justify-between py-2 px-3 bg-gray-50 rounded-xl">
                        <div class="flex-1 min-w-0 mr-3">
                            <p class="text-sm text-gray-800">
                                Paint damage on bedroom wall
                            </p>
                            <p class="text-xs text-gray-400">2025-05-15</p>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <span class="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full">Accepted</span><span class="text-sm text-orange-600" style="font-weight: 600">- ৳5,000</span>
                        </div>
                    </div>
                    <div class="flex items-center justify-between py-2 px-3 bg-gray-50 rounded-xl">
                        <div class="flex-1 min-w-0 mr-3">
                            <p class="text-sm text-gray-800">Missing window grill</p>
                            <p class="text-xs text-gray-400">2025-05-15</p>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <span class="flex items-center gap-1 text-xs bg-red-100 text-red-600 px-2 py-0.5 rounded-full">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="24"
                                     height="24"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     class="lucide lucide-flag w-3 h-3">
                                    <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
                                    <line x1="4" x2="4" y1="22" y2="15"></line>
                                </svg>
                                Disputed
                            </span>
                            <span class="text-sm text-orange-600" style="font-weight: 600">- ৳8,000</span>
                        </div>
                    </div>
                </div>
                <div class="mt-3 bg-red-50 border border-red-100 rounded-xl p-3 flex items-start gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="24"
                         height="24"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         class="lucide lucide-triangle-alert w-4 h-4 text-red-500 mt-0.5 shrink-0">
                        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
                        <path d="M12 9v4"></path>
                        <path d="M12 17h.01"></path>
                    </svg>
                    <p class="text-sm text-red-700">
                        One or more deductions are disputed. This deposit is under review
                        by TenantBridge admin.
                    </p>
                </div>
            </div>
            <div class="flex gap-2 pt-2 border-t border-gray-50">
                <button class="flex-1 text-sm border border-gray-200 text-gray-600 py-2 rounded-xl hover:bg-gray-50 transition-colors">
                    Add Deduction
                </button><button class="flex-1 text-sm bg-purple-600 text-white py-2 rounded-xl hover:bg-purple-700 transition-colors">
                Resolve Dispute
            </button>
        </div>
    </div>
</div>
</div>
</main>
