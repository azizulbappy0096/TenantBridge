@{
    Layout = "_LandlordDashboardLayout";
}

<main class="flex-1 p-5 lg:p-7 overflow-y-auto">
    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-gray-900">Deposit Escrow — Your Properties</h1>
                <p class="text-gray-500 text-sm mt-1">
                    Track deposit, deductions, refunds and disputes
                </p>
            </div>
            <button onclick="openModal()" class="flex items-center gap-2 bg-purple-600 text-white px-4 py-2 rounded-xl text-sm hover:bg-purple-700 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-plus w-4 h-4">
                    <path d="M5 12h14"></path>
                    <path d="M12 5v14"></path>
                </svg>
                Record Deposit
            </button>
        </div>
        <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-3 flex items-start gap-2 text-sm text-indigo-700">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="24"
                 height="24"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 class="lucide lucide-info w-4 h-4 mt-0.5 shrink-0">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 16v-4"></path>
                <path d="M12 8h.01"></path>
            </svg>
            Manage deposits for your properties. Add deductions and process refunds
            when tenancy ends.
        </div>
        <div class="grid grid-cols-3 gap-4">
            <div class="bg-green-50 border border-green-100 rounded-2xl p-4">
                <p class="text-green-600 text-sm">Total in Escrow</p>
                <p class="text-green-900 mt-1"
                   style="font-size: 1.4rem; font-weight: 700">
                    ৳@ViewBag.TotalDeposit
                </p>
            </div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-5">
            @foreach (var deposit in Model)
            {
                <partial name="~/Views/Shared/Partials/Deposit/_DepositCard.cshtml" model="deposit" />
            }
        </div>
    </div>

</main>

<partial name="~/Views/Shared/Partials/Deposit/_DepositModal.cshtml" />



@section Scripts {
    <script>
        const modal = document.getElementById("modal");

        const messageContainer = document.getElementById("messageContainer");

        const messageTemplate = (message, success) => success ? `
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">${message}</span>
            </div>
        ` : `<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">${message}</span>
            </div>`;


        function openModal() {
          modal.classList.remove("hidden");
          modal.classList.add("flex");
        }

        function closeModal() {
            modal.classList.add("hidden");
            modal.classList.remove("flex");
        }


        const errorElems = {
            PropertyLeaseId: document.getElementById("PropertyLeaseId-error"),
            Amount: document.getElementById("Amount-error"),
            PaidDate: document.getElementById("PaidDate-error")
        }

        function submitForm(event) {
            event.preventDefault();

            const form = event.target;
            const data = new FormData(form);

            fetch('/api/payment', {
                method: 'POST',
                body: data
            }).then(async response => {
                let jsonRes = await response.json();
                if (response.ok) {
                    window.location.reload()
                }else if(response.status === 400) {
                    Object.keys(jsonRes.errors).forEach(key => {
                        if (errorElems[key]) {
                            errorElems[key].textContent = jsonRes.errors[key][0];
                        }
                    });
                }else {
                    messageContainer.innerHTML = messageTemplate('Failed to add deposit. Please try again.', false);
                }
            }).catch(error => {
                messageContainer.innerHTML = messageTemplate('Failed to add deposit. Please try again.', false);
            });
        }

    </script>
}