@{
    Layout = "_LandlordDashboardLayout";
}

<main class="flex-1 p-5 lg:p-7 overflow-y-auto">
    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-gray-900">Tenant Rent Tracker</h1>
                <p class="text-gray-500 text-sm mt-1">
                    Track payments across your properties
                </p>
            </div>
            <button onclick="openModal()" class="flex items-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-xl text-sm hover:bg-indigo-700 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-plus w-4 h-4">
                    <path d="M5 12h14"></path>
                    <path d="M12 5v14"></path>
                </svg>
                Log Payment
            </button>
        </div>
        <div class="grid grid-cols-3 gap-4">
            <div class="bg-green-50 border border-green-100 rounded-2xl p-4">
                <p class="text-green-600 text-sm">Total Collected</p>
                <p class="text-green-800 mt-1"
                   style="font-size: 1.4rem; font-weight: 700">
                    ৳@ViewBag.Analytics.RentCollected
                </p>
            </div>
            <div class="bg-orange-50 border border-orange-100 rounded-2xl p-4">
                <p class="text-orange-600 text-sm">Pending Rent</p>
                <p class="text-orange-800 mt-1"
                   style="font-size: 1.4rem; font-weight: 700">
                    ৳@ViewBag.Analytics.PendingRent
                </p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-2xl p-4">
                <p class="text-red-600 text-sm">Collection Rate</p>
                <p class="text-red-800 mt-1"
                   style="font-size: 1.4rem; font-weight: 700">
                    @ViewBag.Analytics.CollectionRate.ToString("F2")%
                </p>
            </div>
        </div>
        <div class="flex gap-2">
            <button class="px-4 py-1.5 rounded-xl text-sm transition-colors bg-indigo-600 text-white">
                All
            </button>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-100">
                            <th class="text-center px-5 py-3 text-gray-500 font-medium">
                                Receipt
                            </th>
                            <th class="text-left px-5 py-3 text-gray-500 font-medium">
                                Tenant
                            </th>
                            <th class="text-left px-5 py-3 text-gray-500 font-medium">
                                Month
                            </th>
                            <th class="text-left px-5 py-3 text-gray-500 font-medium">
                                Paid Date
                            </th>
                            <th class="text-right px-5 py-3 text-gray-500 font-medium">
                                Rent
                            </th>
                            <th class="text-center px-5 py-3 text-gray-500 font-medium">
                                Status
                            </th>
                            <th class="text-center px-5 py-3 text-gray-500 font-medium">
                                Action
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model)
                        {
                            <partial name="~/Views/Shared/Partials/RentTracker/_RentTableRow.cshtml" model="payment" />
                        }

                    </tbody>
                </table>

            </div>
        </div>
    </div>
</main>


<partial name="~/Views/Shared/Partials/RentTracker/_RentCreateModal.cshtml" />



@section Scripts {
    <script>
        const modal = document.getElementById("modal");

        const messageContainer = document.getElementById("messageContainer");

        const messageTemplate = (message, success) => success ? `
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">${message}</span>
            </div>
        ` : `<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">${message}</span>
            </div>`;


        function openModal() {
          modal.classList.remove("hidden");
          modal.classList.add("flex");
        }

        function closeModal() {
            modal.classList.add("hidden");
            modal.classList.remove("flex");
        }


        const errorElems = {
            PropertyLeaseId: document.getElementById("PropertyLeaseId-error"),
            Amount: document.getElementById("Amount-error"),
            PaidDate: document.getElementById("PaidDate-error"),
            Status: document.getElementById("Status-error"),
            RentMonth: document.getElementById("RentMonth-error"),
        }


        function submitForm(event) {
            event.preventDefault();

            const form = event.target;
            const data = new FormData(form);

            fetch('/api/payment', {
                method: 'POST',
                body: data
            }).then(async response => {
                let jsonRes = await response.json();
                if (response.ok) {
                    window.location.reload()
                }else if(response.status === 400) {
                    errorElems.PropertyLeaseId.innerHTML = jsonRes?.errors?.PropertyLeaseId ?? "";
                    errorElems.Amount.innerHTML = jsonRes?.errors?.Amount ?? "";
                    errorElems.PaidDate.innerHTML = jsonRes?.errors?.PaidDate ?? "";
                    errorElems.Status.innerHTML = jsonRes?.errors?.Status ?? "";
                    errorElems.RentMonth.innerHTML = jsonRes?.errors?.RentMonth ?? "";
                }else {
                    messageContainer.innerHTML = messageTemplate('Failed to add deposit. Please try again.', false);
                }
            }).catch(error => {
                messageContainer.innerHTML = messageTemplate('Failed to add deposit. Please try again.', false);
            });
        }

        function updatePayment(id, status) {
            const data = new FormData();
            data.set("Status", status)

            fetch(`/api/payment/${id}`, {
                method: 'PUT',
                body: data
            }).then(async response => {
                let jsonRes = await response.json();
                if (response.ok) {
                    window.location.reload()
                } else {
                    messageContainer.innerHTML = messageTemplate('Failed to update payment. Please try again.', false);
                }
            }).catch(error => {
                messageContainer.innerHTML = messageTemplate('Failed to update payment. Please try again.', false);
            });
        }

            

    </script>
}