@{
    Layout = "_LandlordDashboardLayout";
}

<main class="flex-1 p-5 lg:p-7 overflow-y-auto">
    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-gray-900">Lease Alerts — Your Properties</h1>
                <p class="text-gray-500 text-sm mt-1">
                    Auto-notifications at 60, 30, and 7 days before expiry
                </p>
            </div>
            <button class="flex items-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-xl text-sm hover:bg-indigo-700 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-refresh-cw w-4 h-4">
                    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                    <path d="M21 3v5h-5"></path>
                    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
                    <path d="M8 16H3v5"></path>
                </svg>
                Renew Lease
            </button>
        </div>
        <div class="grid grid-cols-3 gap-4">
            <div class="bg-gray-50 border-gray-200 border rounded-2xl p-4 flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-triangle-alert w-8 h-8 text-gray-300">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
                    <path d="M12 9v4"></path>
                    <path d="M12 17h.01"></path>
                </svg>
                <div>
                    <p class="text-sm text-gray-400">Critical (&lt;7 days)</p>
                    <p class="text-gray-500" style="font-size: 1.5rem; font-weight: 700">
                        0
                    </p>
                </div>
            </div>
            <div class="bg-orange-50 border-orange-200 border rounded-2xl p-4 flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-clock w-8 h-8 text-orange-500">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <div>
                    <p class="text-sm text-orange-600">30-Day Warning</p>
                    <p class="text-orange-800"
                       style="font-size: 1.5rem; font-weight: 700">
                        1
                    </p>
                </div>
            </div>
            <div class="bg-gray-50 border-gray-200 border rounded-2xl p-4 flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-calendar w-8 h-8 text-gray-300">
                    <path d="M8 2v4"></path>
                    <path d="M16 2v4"></path>
                    <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                    <path d="M3 10h18"></path>
                </svg>
                <div>
                    <p class="text-sm text-gray-400">60-Day Notice</p>
                    <p class="text-gray-500" style="font-size: 1.5rem; font-weight: 700">
                        0
                    </p>
                </div>
            </div>
        </div>
        <div>
            <h3 class="text-gray-700 mb-3">Active Leases</h3>
            <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-5">
                <div class="rounded-2xl border-2 p-5 bg-orange-50 border-orange-200 space-y-4">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <span class="text-xs px-2.5 py-1 rounded-full bg-orange-500 text-white">30-Day Warning</span>
                            <h4 class="mt-2 text-orange-700">Farhan Hossain</h4>
                            <p class="text-gray-500 text-sm">Landlord: Rahim Uddin</p>
                        </div>
                        <div class="text-right">
                            <p class="text-orange-700"
                               style="font-size: 1.8rem; font-weight: 800; line-height: 1">
                                17
                            </p>
                            <p class="text-gray-400 text-xs">days left</p>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-xs text-gray-500 mb-1">
                            <span>Start: 2024-06-01</span><span>End: 2026-05-31</span>
                        </div>
                        <div class="w-full bg-white/60 rounded-full h-2.5 overflow-hidden">
                            <div class="h-2.5 rounded-full transition-all bg-orange-400"
                                 style="width: 98%"></div>
                        </div>
                        <p class="text-xs text-gray-400 mt-1">98% of lease elapsed</p>
                    </div>
                    <div class="grid grid-cols-2 gap-3 bg-white/60 rounded-xl p-3">
                        <div>
                            <p class="text-xs text-gray-400">Monthly Rent</p>
                            <p class="text-gray-800 text-sm" style="font-weight: 600">
                                ৳18,000
                            </p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Status</p>
                            <p class="text-gray-800 text-sm" style="font-weight: 600">
                                Warning
                            </p>
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <button class="flex-1 flex items-center justify-center gap-1.5 text-sm border border-gray-300 bg-white text-gray-700 py-2 rounded-xl hover:bg-gray-50 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="24"
                                 height="24"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="lucide lucide-bell w-3.5 h-3.5">
                                <path d="M10.268 21a2 2 0 0 0 3.464 0"></path>
                                <path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path>
                            </svg>
                            Send Reminder
                        </button>
                        <button class="flex-1 flex items-center justify-center gap-1.5 text-sm bg-indigo-600 text-white py-2 rounded-xl hover:bg-indigo-700 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="24"
                                 height="24"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="lucide lucide-refresh-cw w-3.5 h-3.5">
                                <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                                <path d="M21 3v5h-5"></path>
                                <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
                                <path d="M8 16H3v5"></path>
                            </svg>
                            Renew Lease
                        </button>
                    </div>
                </div>
                <div class="rounded-2xl border-2 p-5 bg-green-50 border-green-100 space-y-4">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <span class="text-xs px-2.5 py-1 rounded-full bg-green-500 text-white">Active</span>
                            <h4 class="mt-2 text-green-700">Nusrat Jahan</h4>
                            <p class="text-gray-500 text-sm">Landlord: Rahim Uddin</p>
                        </div>
                        <div class="text-right">
                            <p class="text-green-700"
                               style="font-size: 1.8rem; font-weight: 800; line-height: 1">
                                109
                            </p>
                            <p class="text-gray-400 text-xs">days left</p>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-xs text-gray-500 mb-1">
                            <span>Start: 2023-09-01</span><span>End: 2026-08-31</span>
                        </div>
                        <div class="w-full bg-white/60 rounded-full h-2.5 overflow-hidden">
                            <div class="h-2.5 rounded-full transition-all bg-green-400"
                                 style="width: 90%"></div>
                        </div>
                        <p class="text-xs text-gray-400 mt-1">90% of lease elapsed</p>
                    </div>
                    <div class="grid grid-cols-2 gap-3 bg-white/60 rounded-xl p-3">
                        <div>
                            <p class="text-xs text-gray-400">Monthly Rent</p>
                            <p class="text-gray-800 text-sm" style="font-weight: 600">
                                ৳25,000
                            </p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400">Status</p>
                            <p class="text-gray-800 text-sm" style="font-weight: 600">
                                Active
                            </p>
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <button class="flex-1 flex items-center justify-center gap-1.5 text-sm border border-gray-300 bg-white text-gray-700 py-2 rounded-xl hover:bg-gray-50 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="24"
                                 height="24"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="lucide lucide-bell w-3.5 h-3.5">
                                <path d="M10.268 21a2 2 0 0 0 3.464 0"></path>
                                <path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path>
                            </svg>
                            Send Reminder
                        </button>
                        <button class="flex-1 flex items-center justify-center gap-1.5 text-sm bg-indigo-600 text-white py-2 rounded-xl hover:bg-indigo-700 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="24"
                                 height="24"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="lucide lucide-refresh-cw w-3.5 h-3.5">
                                <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                                <path d="M21 3v5h-5"></path>
                                <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
                                <path d="M8 16H3v5"></path>
                            </svg>
                            Renew Lease
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
            <h3 class="text-gray-900 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-bell w-4 h-4 text-orange-500">
                    <path d="M10.268 21a2 2 0 0 0 3.464 0"></path>
                    <path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path>
                </svg>
                Expiry Alert Summary
            </h3>
            <div class="space-y-3">
                <div class="flex items-center gap-4 py-2 border-b border-gray-50 last:border-0">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 bg-orange-100 text-orange-700">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="lucide lucide-bell w-4 h-4">
                            <path d="M10.268 21a2 2 0 0 0 3.464 0"></path>
                            <path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path>
                        </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="text-sm text-gray-800" style="font-weight: 500">Farhan Hossain</span><span class="text-xs px-2 py-0.5 rounded-full bg-orange-100 text-orange-700">30-Day Alert</span>
                        </div>
                        <p class="text-xs text-gray-400 mt-0.5">
                            Expires 2026-05-31 · 17 days remaining
                        </p>
                    </div>
                    <div class="shrink-0">
                        <span class="flex items-center gap-1 text-xs text-orange-500">Pending action</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
