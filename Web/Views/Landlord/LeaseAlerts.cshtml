@{
    Layout = "_LandlordDashboardLayout";

}

<main class="flex-1 p-5 lg:p-7 overflow-y-auto">
    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-gray-900">Leases — Your Properties</h1>
            </div>
            <button onclick="openCreateModal()" class="flex items-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-xl text-sm hover:bg-indigo-700 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-refresh-cw w-4 h-4">
                    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                    <path d="M21 3v5h-5"></path>
                    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
                    <path d="M8 16H3v5"></path>
                </svg>
                Create Lease
            </button>
        </div>
        <div class="grid grid-cols-3 gap-4">
            <div class="bg-green-50 border-green-200 border rounded-2xl p-4 flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-calendar w-8 h-8 text-green-300">
                    <path d="M8 2v4"></path>
                    <path d="M16 2v4"></path>
                    <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                    <path d="M3 10h18"></path>
                </svg>
                <div>
                    <p class="text-sm text-green-400">Total</p>
                    <p class="text-green-500" style="font-size: 1.5rem; font-weight: 700">
                        @ViewBag.Analytics.Total
                    </p>
                </div>
            </div>
            <div class="bg-red-50 border-red-200 border rounded-2xl p-4 flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-triangle-alert w-8 h-8 text-red-300">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
                    <path d="M12 9v4"></path>
                    <path d="M12 17h.01"></path>
                </svg>
                <div>
                    <p class="text-sm text-red-400">Critical (&lt;7 days)</p>
                    <p class="text-red-500" style="font-size: 1.5rem; font-weight: 700">
                        @ViewBag.Analytics.ExpireIn7Days
                    </p>
                </div>
            </div>
            <div class="bg-orange-50 border-orange-200 border rounded-2xl p-4 flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-clock w-8 h-8 text-orange-500">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <div>
                    <p class="text-sm text-orange-600">30-Day Warning</p>
                    <p class="text-orange-800"
                       style="font-size: 1.5rem; font-weight: 700">
                        @ViewBag.Analytics.ExpireIn30Days
                    </p>
                </div>
            </div>
            
        </div>
        <div>
            <h3 class="text-gray-700 mb-3">Active Leases</h3>
            <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-5">
                @foreach(var lease in Model)
                {
                    <partial name="~/Views/Shared/Partials/Lease/_LeaseCard.cshtml" model="lease" />
                    <partial name="~/Views/Shared/Partials/Lease/_LeaseRenewModal.cshtml" model="lease" />
                }
                
            </div>
        </div>
        
    </div>
</main>

<partial name="~/Views/Shared/Partials/Lease/_LeaseCreateModal.cshtml" model="Model" />



@section Scripts {
    <script>
        const modal = document.getElementById("createModal");
        const renewModal = document.getElementById("renewModal");

        const messageContainer = document.getElementById("messageContainer");
        const messageContainer2 = document.getElementById("messageContainer_2");

        const messageTemplate = (message, success) => success ? `
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">${message}</span>
            </div>
        ` : `<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">${message}</span>
            </div>`;

        const errorElems = {
            'PropertyId': document.getElementById('PropertyId-error'),
            'TenantId': document.getElementById('TenantId-error'),
            'StartDate': document.getElementById('StartDate-error'),
            'EndDate': document.getElementById('EndDate-error'),
            'RentAmount': document.getElementById('RentAmount-error'),
            'DepositAmount': document.getElementById('DepositAmount-error')
        }

        function openCreateModal() {
          modal.classList.remove("hidden");
          modal.classList.add("flex");
        }

        function closeCreateModal() {
            modal.classList.add("hidden");
            modal.classList.remove("flex");
        }

        function openRenewModal() {
          renewModal.classList.remove("hidden");
          renewModal.classList.add("flex");
        }

        function closeRenewModal() {
            renewModal.classList.add("hidden");
            renewModal.classList.remove("flex");
        }

        function submitCreateForm(event) {
            event.preventDefault();

            const form = event.target;
            const data = new FormData(form);

            fetch('/api/lease', {
                method: 'POST',
                body: data
            }).then(async response => {
                let jsonRes = await response.json();
                if (response.ok) {
                    window.location.reload()
                }else if (response.status === 400) {
                    Object.keys(jsonRes.errors).forEach(key => {
                        if (errorElems[key]) {
                            errorElems[key].textContent = jsonRes.errors[key][0];
                        }
                    });
                } else {
                    messageContainer.innerHTML = messageTemplate('Failed to add lease. Please try again.', false);
                }
            }).catch(error => {
                messageContainer.innerHTML = messageTemplate('Failed to add lease. Please try again.', false);
            });
        }

         function submitRenewForm(event) {
            event.preventDefault();

            const form = event.target;
            const data = new FormData(form);

            fetch(`/api/lease/${data.get('Id')}`, {
                method: 'PUT',
                body: data
            }).then(async response => {
                let jsonRes = await response.json();
                if (response.ok) {
                    window.location.reload()
                }else if (response.status === 400) {
                    Object.keys(jsonRes.errors).forEach(key => {
                        if (errorElems[key]) {
                            errorElems[key].textContent = jsonRes.errors[key][0];
                        }
                    });
                }else {
                    messageContainer.innerHTML = messageTemplate('Failed to add lease. Please try again.', false);
                }
            }).catch(error => {
                messageContainer.innerHTML = messageTemplate('Failed to add lease. Please try again.', false);
            });
        }

        function deleteLease(id) {
            if (!confirm('Are you sure you want to delete this lease?')) {
                return;
            }
            fetch(`/api/lease/${id}`, {
                method: 'DELETE'
            }).then(response => {
                if (response.ok) {
                    document.getElementById(`property_${id}`).remove();
                } else {
                    alert('Failed to delete lease. Please try again.');
                }
            }).catch(error => {
                alert('Failed to delete lease. Please try again.');
            });
        }

        
    </script>
}