@{
    Layout = "_TenantDashboardLayout";

}

<main class="flex-1 p-5 lg:p-7 overflow-y-auto">
    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-gray-900">Your Leases</h1>
            </div>
   
        </div>
        <div class="grid grid-cols-3 gap-4">
            <div class="bg-green-50 border-green-200 border rounded-2xl p-4 flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-calendar w-8 h-8 text-green-300">
                    <path d="M8 2v4"></path>
                    <path d="M16 2v4"></path>
                    <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                    <path d="M3 10h18"></path>
                </svg>
                <div>
                    <p class="text-sm text-green-400">Total</p>
                    <p class="text-green-500" style="font-size: 1.5rem; font-weight: 700">
                        @ViewBag.Analytics.Total
                    </p>
                </div>
            </div>
            <div class="bg-red-50 border-red-200 border rounded-2xl p-4 flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-triangle-alert w-8 h-8 text-red-300">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
                    <path d="M12 9v4"></path>
                    <path d="M12 17h.01"></path>
                </svg>
                <div>
                    <p class="text-sm text-red-400">Critical (&lt;7 days)</p>
                    <p class="text-red-500" style="font-size: 1.5rem; font-weight: 700">
                        @ViewBag.Analytics.ExpireIn7Days
                    </p>
                </div>
            </div>
            <div class="bg-orange-50 border-orange-200 border rounded-2xl p-4 flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-clock w-8 h-8 text-orange-500">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <div>
                    <p class="text-sm text-orange-600">30-Day Warning</p>
                    <p class="text-orange-800"
                       style="font-size: 1.5rem; font-weight: 700">
                        @ViewBag.Analytics.ExpireIn30Days
                    </p>
                </div>
            </div>
            
        </div>
        <div>
            <h3 class="text-gray-700 mb-3">Active Leases</h3>
            <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-5">
                @foreach(var lease in Model)
                {
                    <partial name="~/Views/Shared/Partials/Lease/_TenantLeaseCard.cshtml" model="lease" />
                }
                
            </div>
        </div>
        
    </div>
</main>

