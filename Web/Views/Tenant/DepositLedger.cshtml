@{
    Layout = "_TenantDashboardLayout";
}

<main class="flex-1 p-5 lg:p-7 overflow-y-auto">
    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-gray-900">Deposit Escrow — Your Leases</h1>
                <p class="text-gray-500 text-sm mt-1">
                    Track deposits
                </p>
            </div>
        </div>
        <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-3 flex items-start gap-2 text-sm text-indigo-700">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="24"
                 height="24"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 class="lucide lucide-info w-4 h-4 mt-0.5 shrink-0">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 16v-4"></path>
                <path d="M12 8h.01"></path>
            </svg>
            View deposits for your leases.
        </div>
        <div class="grid grid-cols-3 gap-4">
            <div class="bg-green-50 border border-green-100 rounded-2xl p-4">
                <p class="text-green-600 text-sm">Total in Escrow</p>
                <p class="text-green-900 mt-1"
                   style="font-size: 1.4rem; font-weight: 700">
                    ৳@ViewBag.TotalDeposit
                </p>
            </div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-5">
            @foreach (var deposit in Model)
            {
                <partial name="~/Views/Shared/Partials/Deposit/_TenantDepositCard.cshtml" model="deposit" />
            }
        </div>
    </div>

</main>