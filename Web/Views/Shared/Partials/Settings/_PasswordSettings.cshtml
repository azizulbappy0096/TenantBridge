@model BLL.DTOs.Auth.ChangePasswordDTO

<div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
    <h3 class="text-gray-900 mb-4 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg"
             width="24"
             height="24"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             class="lucide lucide-lock w-4 h-4 text-gray-500">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        Change Password
    </h3>
    <form asp-controller="Auth" asp-action="ChangePassword" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <div>
            <label class="text-sm text-gray-600 mb-1.5 block">Old Password</label>
            <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-lock absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <input type="password"
                       required=""
                       placeholder="Min. 8 characters"
                       class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 bg-gray-50 focus:bg-white transition-colors"
                       asp-for="OldPassword" />
            </div>
            <span asp-validation-for="OldPassword" class="text-sm text-red-500"></span>
        </div>
        <div>
            <label class="text-sm text-gray-600 mb-1.5 block">New Password</label>
            <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-lock absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <input type="password"
                       required=""
                       placeholder="Min. 8 characters"
                       class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 bg-gray-50 focus:bg-white transition-colors"
                       asp-for="NewPassword" />
            </div>
            <span asp-validation-for="NewPassword" class="text-sm text-red-500"></span>
        </div>
        <div>
            <label class="text-sm text-gray-600 mb-1.5 block">Confirm New Password</label>
            <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-lock absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <input type="password"
                       required=""
                       placeholder="Repeat new password"
                       class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 bg-gray-50 focus:bg-white transition-colors"
                       asp-for="ConfirmNewPassword" />
            </div>
            <span asp-validation-for="ConfirmNewPassword" class="text-sm text-red-500"></span>
        </div>
        <div class="flex items-center gap-2">
            <input type="checkbox"
                   id="showpw"
                   class="rounded border-gray-300" /><label for="showpw" class="text-sm text-gray-500 cursor-pointer">Show passwords</label>
        </div>
        <button type="submit"
                class="w-full bg-indigo-600 text-white py-2.5 rounded-xl text-sm hover:bg-indigo-700 disabled:opacity-70 flex items-center justify-center gap-2 transition-colors">
            Update Password
        </button>
    </form>
    <div class="mt-5 pt-5 border-t border-gray-100">
        <div class="flex items-center justify-between gap-3">
            <div>
                <p class="text-sm text-gray-700" style="font-weight: 500">
                    Forgot your password?
                </p>
                <p class="text-xs text-gray-400 mt-0.5">
                    Send a reset link to your email
                </p>
            </div>
            <button class="shrink-0 text-sm text-indigo-600 hover:text-indigo-800 px-3 py-1.5 rounded-xl border border-indigo-200 hover:bg-indigo-50 disabled:opacity-60 flex items-center gap-1.5 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-key w-3.5 h-3.5">
                    <path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"></path>
                    <path d="m21 2-9.6 9.6"></path>
                    <circle cx="7.5" cy="15.5" r="5.5"></circle>
                </svg>
                Send Link
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('showpw').addEventListener('change', function () {
            const pwFields = document.querySelectorAll('input[type="password"]');
            pwFields.forEach(field => {
                field.type = this.checked ? 'text' : 'password';
            });
        });
    </script>
}