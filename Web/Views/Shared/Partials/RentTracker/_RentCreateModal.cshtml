

<div id="modal" class="fixed inset-0 bg-black/40 z-50 hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6">
        <div class="flex items-center justify-between mb-5">
            <h3>Record New Deposit</h3>
            <button onclick="closeModal()">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x w-5 h-5 text-gray-400">
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                </svg>
            </button>
        </div>
        <div id="messageContainer">
        </div>
        <form onsubmit="submitForm(event)">
            <input type="hidden" name="Type" value="Rent" />
            <div class="space-y-4">
                <div>
                    <label class="text-sm text-gray-600 mb-1 block">Property / Tenant</label>
                    <select name="PropertyLeaseId" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300">
                        <option value="" disabled selected>Select a property-tenant</option>
                        @foreach (var lease in ViewBag.Leases)
                        {
                            var tenant = lease.Tenant;
                            <option value="@lease.PropertyId-@lease?.Id">@lease.Property.Address-@tenant?.FullName</option>

                        }
                    </select>
                </div>
                <div>
                    <label class="text-sm text-gray-600 mb-1 block">Month</label>
                    <input type="month"
                           class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300"
                           name="RentMonth"
                           
                           />
                </div>

                <div>
                    <label class="text-sm text-gray-600 mb-1 block">Property / Tenant</label>
                    <select name="Status" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300">
                        <option value="" disabled selected>Select a property-tenant</option>
                        <option value="Paid">Paid</option>
                        <option value="Pending">Pending</option>
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div><label class="text-sm text-gray-600 mb-1 block">Deposit Amount (৳)</label><input type="number" name="Amount" placeholder="54000" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300" value=""></div>
                    <div><label class="text-sm text-gray-600 mb-1 block">Date Received</label><input type="datetime-local" name="PaidDate" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300" value="2026-05-16"></div>
                </div>
            </div>
            <div class="mt-5 flex gap-2"><button type="submit" class="flex-1 flex items-center justify-center gap-2 bg-purple-600 text-white py-2 rounded-xl text-sm hover:bg-purple-700 transition-colors disabled:opacity-60"> Record Deposit</button><button type="button" onclick="closeModal()" class="px-4 py-2 border border-gray-200 rounded-xl text-sm text-gray-600">Cancel</button></div>
        </form>
    </div>
</div>