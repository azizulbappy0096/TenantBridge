@model BLL.DTOs.PropertyDTO

@{
    var Lease = Model.Leases.Count > 0 ? Model.Leases.FirstOrDefault() : null;
}

<div id="property_@Model.Id" class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 space-y-4">
    <div class="flex items-start gap-3">
        <div class="w-9 h-9 bg-indigo-50 rounded-xl flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="24"
                 height="24"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 class="lucide lucide-house w-4 h-4 text-indigo-600">
                <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path>
                <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            </svg>
        </div>
        <div class="flex-1 min-w-0">
            <p class="text-gray-900 text-sm truncate"
               style="font-weight: 600">
                @Model.Address
            </p>
            @if(Lease != null)
            {
                var DaysLeft = Lease?.EndDate.ToDateTime(TimeOnly.MinValue).Subtract(DateTime.Now).Days;
                if(Lease.Active)
                {
                    <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full">@DaysLeft days left — Active</span>
                }
                
            }else
            {
                <span class="text-xs bg-gray-100 text-gray-700 px-2 py-0.5 rounded-full"> — </span>
            }
            
        </div>
    </div>
    <div class="grid grid-cols-2 gap-3 bg-gray-50 rounded-xl p-3">
        <div>
            <p class="text-xs text-gray-400 flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-dollar-sign w-3 h-3">
                    <line x1="12" x2="12" y1="2" y2="22"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
                Monthly Rent
            </p>
            <p class="text-sm text-gray-800 mt-0.5" style="font-weight: 600">
                @(Lease != null ? $"৳{Lease.RentAmount}" : "—")
            </p>
        </div>
        <div>
            <p class="text-xs text-gray-400 flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-user w-3 h-3">
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                Tenant
            </p>
            <p class="text-sm text-gray-800 mt-0.5 truncate"
               style="font-weight: 500">
                @(Lease?.Tenant?.FullName ?? "—")
            </p>
        </div>
        <div>
            <p class="text-xs text-gray-400 flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-calendar-days w-3 h-3">
                    <path d="M8 2v4"></path>
                    <path d="M16 2v4"></path>
                    <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                    <path d="M3 10h18"></path>
                    <path d="M8 14h.01"></path>
                    <path d="M12 14h.01"></path>
                    <path d="M16 14h.01"></path>
                    <path d="M8 18h.01"></path>
                    <path d="M12 18h.01"></path>
                    <path d="M16 18h.01"></path>
                </svg>
                Lease Start
            </p>
            <p class="text-sm text-gray-800 mt-0.5"> @(Lease != null ? Lease.StartDate : "—")</p>
        </div>
        <div>
            <p class="text-xs text-gray-400 flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-calendar-days w-3 h-3">
                    <path d="M8 2v4"></path>
                    <path d="M16 2v4"></path>
                    <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                    <path d="M3 10h18"></path>
                    <path d="M8 14h.01"></path>
                    <path d="M12 14h.01"></path>
                    <path d="M16 14h.01"></path>
                    <path d="M8 18h.01"></path>
                    <path d="M12 18h.01"></path>
                    <path d="M16 18h.01"></path>
                </svg>
                Lease End
            </p>
            <p class="text-sm text-gray-800 mt-0.5">@(Lease != null ? Lease.EndDate : "—")</p>
        </div>
    </div>

    
    <button type="button" onclick="deleteProperty(@Model.Id)" class="w-full text-xs text-red-600 hover:text-red-800 px-3 py-2 bg-red-50 border border-red-100 rounded-md hover:bg-red-100 transition-colors">
        Delete
    </button>

</div>