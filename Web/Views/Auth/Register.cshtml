@model BLL.DTOs.Auth.RegistrationDTO;

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Tenant Bridge - Register";
}

<div class="space-y-5">
    <div>
        <h2 class="text-gray-900">Create your account</h2>
        <p class="text-gray-500 text-sm mt-1">
            Join TenantBridge and manage your rental digitally
        </p>
    </div>
    <form asp-action="Register" method="post" class="space-y-4">
        <div>
            <label class="text-sm text-gray-600 mb-1.5 block">Full Name</label>
            <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-user absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400">
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <input placeholder="Your full name"
                       asp-for="FullName"
                       class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 bg-gray-50 focus:bg-white transition-colors" />
            </div>
            <span asp-validation-for="FullName" class="text-red-500 text-sm"></span>
        </div>
        <div>
            <label class="text-sm text-gray-600 mb-1.5 block">Email Address</label>
            <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-mail absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400">
                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
                <input type="email"
                       required=""
                       placeholder="you@example.com"
                       asp-for="Email"
                       class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 bg-gray-50 focus:bg-white transition-colors" />
            </div>
            <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
        </div>
        <div>
            <label class="text-sm text-gray-600 mb-1.5 block">Phone Number</label>
            <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-phone absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <input placeholder="+8801XXX-XXXXXX"
                       asp-for="PhoneNumber"
                       class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 bg-gray-50 focus:bg-white transition-colors" />
            </div>
            <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm"></span>
        </div>
        <div>
            <label class="text-sm text-gray-600 mb-2 block">
                I am a
            </label>

            <div class="grid grid-cols-2 gap-2">

                <input type="hidden"
                       id="roleInput"
                       name="Role"
                       value="2" />

                <button id="tenantBtn"
                        type="button"
                        data-role="tenant"
                        class="role-btn py-3 rounded-xl border-2 text-sm capitalize transition-all border-blue-500 bg-blue-50 text-blue-700 font-semibold">

                    Tenant

                </button>

                <button id="landlordBtn"
                        type="button"
                        data-role="landlord"
                        class="role-btn py-3 rounded-xl border-2 text-sm capitalize transition-all border-gray-200 text-gray-500 hover:border-gray-300">

                    Landlord

                </button>

            </div>
            <span asp-validation-for="Role" class="text-red-500 text-sm"></span>
        </div>
        <div id="propertyCodeWrapper">
            <label class="text-sm text-gray-600 mb-1.5 block">Property Code <span class="text-red-500">*</span></label>
            <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-key-round absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400">
                    <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path>
                    <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
                </svg>
                <input 
                       placeholder="Get this from your landlord"
                       class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 bg-gray-50 focus:bg-white transition-colors"
                        />
            </div>
            <span asp-validation-for="PropertyCode" class="text-red-500 text-sm"></span>
            <p class="text-xs text-gray-400 mt-1">
                Your landlord can share this from the Properties section
            </p>
        </div>

        <div>
            <label class="text-sm text-gray-600 mb-1.5 block"> Password </label>

            <div class="relative">
                <!-- Lock Icon -->
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-lock absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>

                <!-- Password Input -->
                <input id="passwordInput"
                       type="password"
                       required
                       placeholder="••••••••"
                       asp-for="Password"
                       class="w-full pl-10 pr-10 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 bg-gray-50 focus:bg-white transition-colors" />

                <!-- Toggle Button -->
                <button id="togglePassword"
                        type="button"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                    <!-- Eye Open -->
                    <svg id="eyeOpen"
                         xmlns="http://www.w3.org/2000/svg"
                         width="24"
                         height="24"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         class="w-4 h-4">
                        <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>

                    <!-- Eye Closed -->
                    <svg id="eyeClosed"
                         xmlns="http://www.w3.org/2000/svg"
                         width="24"
                         height="24"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         class="w-4 h-4 hidden">
                        <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path>
                        <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path>
                        <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path>
                        <path d="m2 2 20 20"></path>
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label class="text-sm text-gray-600 mb-1.5 block"> Confirm Password </label>

            <div class="relative">
                <!-- Lock Icon -->
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-lock absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>

                <!-- Password Input -->
                <input id="passwordInput"
                       type="password"
                       required
                       placeholder="••••••••"
                       asp-for="ConfirmPassword"
                       class="w-full pl-10 pr-10 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 bg-gray-50 focus:bg-white transition-colors" />

                <!-- Toggle Button -->
                <button id="togglePassword"
                        type="button"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                    <!-- Eye Open -->
                    <svg id="eyeOpen"
                         xmlns="http://www.w3.org/2000/svg"
                         width="24"
                         height="24"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         class="w-4 h-4">
                        <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>

                    <!-- Eye Closed -->
                    <svg id="eyeClosed"
                         xmlns="http://www.w3.org/2000/svg"
                         width="24"
                         height="24"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         class="w-4 h-4 hidden">
                        <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path>
                        <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path>
                        <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path>
                        <path d="m2 2 20 20"></path>
                    </svg>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
        </div>

        <button type="submit"
                class="w-full bg-indigo-600 text-white py-2.5 rounded-xl text-sm hover:bg-indigo-700 transition-colors flex items-center justify-center gap-2 disabled:opacity-70">
            Create Account
        </button>
    </form>
    <p class="text-center text-sm text-gray-500">
        Already have an account?
        <a asp-action="Login" class="text-center text-indigo-600 hover:text-indigo-800"
           style="font-weight: 500">
            Sign in
        </a>
    </p>
</div>


@section Scripts {

    <script>
        function initializeRoleSelection() {

            const tenantBtn =
                document.getElementById("tenantBtn");

            const landlordBtn =
                document.getElementById("landlordBtn");

            const roleInput =
                document.getElementById("roleInput");

            const propertyCodeWrapper =
                document.getElementById("propertyCodeWrapper");

            if (!tenantBtn || !landlordBtn || !propertyCodeWrapper)
                return;

            roleInput.value = "2";
            propertyCodeWrapper.style.display = "block";

            tenantBtn.addEventListener("click", () => {

                roleInput.value = "3";

                tenantBtn.classList.add(
                    "border-blue-500",
                    "bg-blue-50",
                    "text-blue-700",
                    "font-semibold"
                );

                tenantBtn.classList.remove(
                    "border-gray-200",
                    "text-gray-500"
                );

                landlordBtn.classList.remove(
                    "border-blue-500",
                    "bg-blue-50",
                    "text-blue-700",
                    "font-semibold"
                );

                landlordBtn.classList.add(
                    "border-gray-200",
                    "text-gray-500"
                );

                propertyCodeWrapper.style.display = "block";
            });

            landlordBtn.addEventListener("click", () => {

                roleInput.value = "2";

                landlordBtn.classList.add(
                    "border-blue-500",
                    "bg-blue-50",
                    "text-blue-700",
                    "font-semibold"
                );

                landlordBtn.classList.remove(
                    "border-gray-200",
                    "text-gray-500"
                );

                tenantBtn.classList.remove(
                    "border-blue-500",
                    "bg-blue-50",
                    "text-blue-700",
                    "font-semibold"
                );

                tenantBtn.classList.add(
                    "border-gray-200",
                    "text-gray-500"
                );

                propertyCodeWrapper.style.display = "none";
            });
        }

        initializeRoleSelection();

    </script>

}
