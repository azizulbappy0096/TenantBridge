@model Web.Models.SettingsViewModel;
@using BLL.Enums;

@{
    Layout = Model.User.Role == (int)UserRole.Landlord ? "_LandlordDashboardLayout" : Model.User.Role == (int)UserRole.Tenant ? "_TenantDashboardLayout" : "_Layout";
}

<main class="flex-1 p-5 lg:p-7 overflow-y-auto spac-y-6">
    <div>

        @if (TempData["Success"] != null)
        {
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">@TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">@TempData["Error"]</span>
            </div>
        }

        
    </div>
    <div class="space-y-6 max-w-xl">
        <div>
            <h1 class="text-gray-900">Profile Settings</h1>
            <p class="text-gray-500 text-sm mt-1">
                Manage your account information and security
            </p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
            <div class="flex items-center gap-4">
                <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-white shrink-0 bg-indigo-600"
                     style="font-weight: 700; font-size: 1.5rem">
                    @Model.User.FullName.Substring(0, 1)
                </div>
                <div>
                    <p class="text-gray-900" style="font-weight: 600; font-size: 1.1rem">
                        @Model.User.FullName
                    </p>
                    <p class="text-gray-400 text-sm">landlord@tenantbridge.com</p>
                    <span class="text-xs px-2.5 py-0.5 rounded-full mt-1.5 inline-block bg-indigo-100 text-indigo-700">Landlord</span>
                </div>
            </div>
        </div>

        <partial name="~/Views/Shared/Partials/Settings/_ProfileSettings.cshtml" model="Model.Profile" />
        <partial name="~/Views/Shared/Partials/Settings/_PasswordSettings.cshtml" model="Model.Password" />

        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
            <h3 class="text-gray-900 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-shield w-4 h-4 text-gray-500">
                    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
                </svg>
                Account Details
            </h3>
            <div class="space-y-3 text-sm">
                <div class="flex justify-between py-2 border-b border-gray-50">
                    <span class="text-gray-500">Account Role</span><span class="text-xs px-2.5 py-0.5 rounded-full bg-indigo-100 text-indigo-700">
                    @(Model.User.Role == (int)UserRole.Landlord ? "Landlord" : Model.User.Role == (int)UserRole.Tenant ? "Tenant" : "")
                    </span>
            </div>
            <div class="flex justify-between py-2 border-b border-gray-50">
                <span class="text-gray-500">User ID</span><span class="text-gray-400 text-xs font-mono">
                    @Model.User.Id
                </span>
            </div>
        </div>
    </div>
</div>
</main>

