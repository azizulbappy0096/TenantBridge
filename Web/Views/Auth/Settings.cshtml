@model BLL.DTOs.UserDTO;
@using BLL.Enums;

@{
    Layout = Model.Role == (int)UserRole.Landlord ? "_LandlordDashboardLayout" : Model.Role == (int)UserRole.Tenant ? "_TenantDashboardLayout" : "_Layout";
}

<main class="flex-1 p-5 lg:p-7 overflow-y-auto">
    <div class="space-y-6 max-w-xl">
        <div>
            <h1 class="text-gray-900">Profile Settings</h1>
            <p class="text-gray-500 text-sm mt-1">
                Manage your account information and security
            </p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
            <div class="flex items-center gap-4">
                <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-white shrink-0 bg-indigo-600"
                     style="font-weight: 700; font-size: 1.5rem">
                    RU
                </div>
                <div>
                    <p class="text-gray-900" style="font-weight: 600; font-size: 1.1rem">
                        Rahim Uddin
                    </p>
                    <p class="text-gray-400 text-sm">landlord@tenantbridge.com</p>
                    <span class="text-xs px-2.5 py-0.5 rounded-full mt-1.5 inline-block bg-indigo-100 text-indigo-700">Landlord</span>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
            <h3 class="text-gray-900 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-user w-4 h-4 text-gray-500">
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                Personal Information
            </h3>
            <form class="space-y-4">
                <div>
                    <label class="text-sm text-gray-600 mb-1.5 block">Email Address</label>
                    <div class="relative">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="lucide lucide-mail absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-300">
                            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                        </svg>
                        <input disabled=""
                               class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm bg-gray-50 text-gray-400 cursor-not-allowed"
                               value="landlord@tenantbridge.com" />
                    </div>
                    <p class="text-xs text-gray-400 mt-1">
                        Email address cannot be changed
                    </p>
                </div>
                <div>
                    <label class="text-sm text-gray-600 mb-1.5 block">Full Name</label>
                    <div class="relative">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="lucide lucide-user absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <input required=""
                               class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 bg-gray-50 focus:bg-white transition-colors"
                               value="Rahim Uddin" />
                    </div>
                </div>
                <div>
                    <label class="text-sm text-gray-600 mb-1.5 block">Phone Number</label>
                    <div class="relative">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="lucide lucide-phone absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <input placeholder="+880 1XXX-XXXXXX"
                               class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 bg-gray-50 focus:bg-white transition-colors"
                               value="+880 1812-345678" />
                    </div>
                </div>
                <button type="submit"
                        class="w-full bg-indigo-600 text-white py-2.5 rounded-xl text-sm hover:bg-indigo-700 disabled:opacity-70 flex items-center justify-center gap-2 transition-colors">
                    Save Changes
                </button>
            </form>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
            <h3 class="text-gray-900 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-lock w-4 h-4 text-gray-500">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Change Password
            </h3>
            <form class="space-y-4">
                <div>
                    <label class="text-sm text-gray-600 mb-1.5 block">New Password</label>
                    <div class="relative">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="lucide lucide-lock absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400">
                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <input type="password"
                               required=""
                               placeholder="Min. 8 characters"
                               class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 bg-gray-50 focus:bg-white transition-colors"
                               value="" />
                    </div>
                </div>
                <div>
                    <label class="text-sm text-gray-600 mb-1.5 block">Confirm New Password</label>
                    <div class="relative">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="lucide lucide-lock absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400">
                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <input type="password"
                               required=""
                               placeholder="Repeat new password"
                               class="w-full pl-10 pr-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 bg-gray-50 focus:bg-white transition-colors"
                               value="" />
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <input type="checkbox"
                           id="showpw"
                           class="rounded border-gray-300" /><label for="showpw" class="text-sm text-gray-500 cursor-pointer">Show passwords</label>
                </div>
                <button type="submit"
                        class="w-full bg-indigo-600 text-white py-2.5 rounded-xl text-sm hover:bg-indigo-700 disabled:opacity-70 flex items-center justify-center gap-2 transition-colors">
                    Update Password
                </button>
            </form>
            <div class="mt-5 pt-5 border-t border-gray-100">
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <p class="text-sm text-gray-700" style="font-weight: 500">
                            Forgot your password?
                        </p>
                        <p class="text-xs text-gray-400 mt-0.5">
                            Send a reset link to your email
                        </p>
                    </div>
                    <button class="shrink-0 text-sm text-indigo-600 hover:text-indigo-800 px-3 py-1.5 rounded-xl border border-indigo-200 hover:bg-indigo-50 disabled:opacity-60 flex items-center gap-1.5 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="lucide lucide-key w-3.5 h-3.5">
                            <path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"></path>
                            <path d="m21 2-9.6 9.6"></path>
                            <circle cx="7.5" cy="15.5" r="5.5"></circle>
                        </svg>
                        Send Link
                    </button>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
            <h3 class="text-gray-900 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-shield w-4 h-4 text-gray-500">
                    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
                </svg>
                Account Details
            </h3>
            <div class="space-y-3 text-sm">
                <div class="flex justify-between py-2 border-b border-gray-50">
                    <span class="text-gray-500">Account Role</span><span class="text-xs px-2.5 py-0.5 rounded-full bg-indigo-100 text-indigo-700">Landlord</span>
                </div>
                <div class="flex justify-between py-2 border-b border-gray-50">
                    <span class="text-gray-500">User ID</span><span class="text-gray-400 text-xs font-mono">8fcf4632-57ff-45…</span>
                </div>
                <div class="flex justify-between py-2">
                    <span class="text-gray-500">Properties Linked</span><span class="text-gray-800" style="font-weight: 500">2</span>
                </div>
            </div>
        </div>
    </div>
</main>
